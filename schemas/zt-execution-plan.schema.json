  "properties":{
    "metadata":{"type":"object","additionalProperties":false,"required":["authority","action_id","actual_project_target","future_roadmap_target","future_roadmap_status","calendar_dates_estimated","implementation_executed","status_promoted"],"properties":{"authority":{"const":"ZT_AUTHORITATIVE_EXECUTION_PLAN"},"action_id":{"const":"ZT-PROJECT-PLAN-001"},"actual_project_target":{"const":"L3_ADVANCED"},"future_roadmap_target":{"const":"L4_OPTIMAL"},"future_roadmap_status":{"const":"ROADMAP_ONLY"},"calendar_dates_estimated":{"const":false},"implementation_executed":{"const":true},"status_promoted":{"const":true}}},
