{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P2-VIS-001 OpenStack deployment contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "package_id", "action_id", "contract_status", "provider", "environment", "deployment_authorized", "runtime_validation_status", "infrastructure_prerequisite", "topology", "components", "access_contract", "secret_contract", "data_contract", "acceptance_cases", "live_gates", "protected_non_authorities", "runtime_executed", "prerequisite_runtime_executed", "live_target_changed", "central_monitoring_completed", "package_runtime_promoted", "maturity_assessed", "compliance_assessed", "next_action"],
  "properties": {
    "contract_id": {"const": "P2-VIS-001-DEPLOYMENT-CONTRACT"},
    "package_id": {"const": "ZT-VIS-002"},
    "action_id": {"const": "P2-VIS-001"},
    "contract_status": {"const": "BOUNDED_DEPLOYMENT_AND_LIVE_VALIDATOR_PARTIALLY_ACCEPTED"},
    "provider": {"const": "OPENSTACK"},
    "environment": {"const": "NON_PRODUCTION_LAB"},
    "deployment_authorized": {"const": true},
    "runtime_validation_status": {"const": "PARTIALLY_VALIDATED"},
    "infrastructure_prerequisite": {
      "type": "object", "additionalProperties": false,
      "required": ["cinder_lvm_status", "dedicated_storage_boundary", "existing_nova_storage_preserved", "full_infrastructure_rollback_executed"],
      "properties": {
        "cinder_lvm_status": {"const": "RUNTIME_VALIDATED"},
        "dedicated_storage_boundary": {"const": "NEW_100_GIB_THIN_DISK_ONLY"},
        "existing_nova_storage_preserved": {"const": true},
        "full_infrastructure_rollback_executed": {"const": false}
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placement", "network", "public_endpoint_allowed", "floating_ip_allowed", "existing_network_resources_only", "candidate_resource_types"],
      "properties": {
        "placement": {"const": "DEDICATED_PRIVATE_OPENSTACK_MONITORING_VM"},
        "network": {"const": "EXISTING_APPROVED_PRIVATE_NETWORK_ONLY"},
        "public_endpoint_allowed": {"const": false},
        "floating_ip_allowed": {"const": false},
        "existing_network_resources_only": {"const": true},
        "candidate_resource_types": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["openstack_networking_port_v2", "openstack_compute_instance_v2", "openstack_blockstorage_volume_v3", "openstack_compute_volume_attach_v2"]}
        }
      }
    },
    "components": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["Grafana", "Loki", "Alloy", "Prometheus", "Blackbox Exporter"]}},
    "access_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["authenticated_reverse_proxy_required", "authentication_method", "anonymous_grafana_allowed", "administrator_role_required", "recovery_access_required", "role_separation", "oidc_status", "design_status"],
      "properties": {
        "authenticated_reverse_proxy_required": {"const": true},
        "authentication_method": {"const": "MUTUAL_TLS_AT_PROXY_PLUS_GRAFANA_LOGIN"},
        "anonymous_grafana_allowed": {"const": false},
        "administrator_role_required": {"const": true},
        "recovery_access_required": {"const": true},
        "role_separation": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["VISIBILITY_VIEWER", "VISIBILITY_ADMINISTRATOR", "RECOVERY_OPERATOR"]}},
        "oidc_status": {"const": "DEFERRED_TO_P2_OIDC_001"},
        "design_status": {"const": "RUNTIME_MTLS_AND_AUTHENTICATION_VALIDATOR_PASSED"}
      }
    },
    "secret_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["openstack_configuration", "runtime_secrets", "repository_credentials_allowed", "terraform_state_tracked", "kubeconfig_tracked"],
      "properties": {
        "openstack_configuration": {"const": "EXTERNAL_CLOUDS_YAML"},
        "runtime_secrets": {"const": "EXTERNAL_SECRET_FILES_OR_ENVIRONMENT"},
        "repository_credentials_allowed": {"const": false},
        "terraform_state_tracked": {"const": false},
        "kubeconfig_tracked": {"const": false}
      }
    },
    "data_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["initial_source_scope", "sanitized_ingestion_required", "forbidden_fields", "retention_candidate", "retention_approved", "retention_design_selected", "primary_storage", "restore_method", "rollback_checkpoint", "backup_restore_approved", "design_status"],
      "properties": {
        "initial_source_scope": {"const": "SANITIZED_PORTAL_DECISION_LIFECYCLE_AND_SERVICE_HEALTH_ONLY"},
        "sanitized_ingestion_required": {"const": true},
        "forbidden_fields": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"enum": ["credentials", "tokens", "private_keys", "personal_data", "raw_runtime_output"]}},
        "retention_candidate": {"const": "PT336H"},
        "retention_approved": {"const": false},
        "retention_design_selected": {"const": true},
        "primary_storage": {"const": "DEDICATED_CINDER_VOLUME"},
        "restore_method": {"const": "REATTACH_PRESERVED_VOLUME_TO_REBUILT_MONITORING_VM"},
        "rollback_checkpoint": {"const": "CINDER_SNAPSHOT_BEFORE_BOUNDED_DEPLOYMENT_TEST"},
        "backup_restore_approved": {"const": false},
        "design_status": {"const": "RUNTIME_RESTART_PERSISTENCE_AND_STACK_RECOVERY_VALIDATED_SNAPSHOT_RESTORE_PENDING"}
      }
    },
    "acceptance_cases": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_type", "required_result"],
        "properties": {
          "case_type": {"enum": ["POSITIVE", "NEGATIVE", "BYPASS", "PERSISTENCE", "ROLLBACK", "EVIDENCE_INTEGRITY"]},
          "required_result": {"type": "string", "minLength": 1}
        }
      }
    },
    "live_gates": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["gate", "status"], "properties": {"gate": {"type": "string", "minLength": 1}, "status": {"enum": ["BOUNDED_DEPLOYMENT_EXECUTED", "RUNTIME_ARTIFACT_LOAD_VERIFIED", "RUNTIME_RESTART_PERSISTENCE_AND_STACK_RECOVERY_VALIDATED_SNAPSHOT_RESTORE_PENDING", "RUNTIME_MTLS_AND_AUTHENTICATION_VALIDATED", "LIVE_VALIDATOR_PARTIAL_STATUS_PROMOTED"]}}}},
    "protected_non_authorities": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": [".runtime/zero-trust/zt-vis-002", "platform"]}},
    "runtime_executed": {"const": true},
    "prerequisite_runtime_executed": {"const": true},
    "live_target_changed": {"const": true},
    "central_monitoring_completed": {"const": false},
    "package_runtime_promoted": {"const": true},
    "maturity_assessed": {"const": false},
    "compliance_assessed": {"const": false},
    "next_action": {"type": "string", "minLength": 1}
  }
}
