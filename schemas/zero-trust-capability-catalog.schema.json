{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/snsd/zero-trust-capability-catalog.schema.json",
  "title": "SNSD Zero Trust Capability Catalog",
  "type": "object",
  "required": [
    "catalog_version",
    "authoritative_document",
    "capability_count",
    "status_note",
    "serialization",
    "capabilities"
  ],
  "properties": {
    "catalog_version": { "type": "string", "minLength": 1 },
    "authoritative_document": { "const": "제로트러스트 가이드라인 2.0" },
    "capability_count": { "const": 52 },
    "status_note": { "type": "string", "minLength": 1 },
    "serialization": { "const": "JSON-compatible YAML 1.2" },
    "capabilities": {
      "type": "array",
      "minItems": 52,
      "maxItems": 52,
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "repositoryStatus": {
      "enum": [
        "REFERENCE_ONLY",
        "MAPPED",
        "PLANNED",
        "IMPLEMENTED",
        "PARTIALLY_VALIDATED",
        "VALIDATED",
        "GAP_IDENTIFIED",
        "NOT_APPLICABLE"
      ]
    },
    "evidenceLevel": {
      "enum": ["NONE", "DESIGN", "CONFIGURATION", "RUNTIME", "CONTINUOUS"]
    },
    "maturityValue": {
      "enum": ["UNASSESSED", "TRADITIONAL", "INITIAL", "ADVANCED", "OPTIMAL", "NOT_APPLICABLE"]
    },
    "evidenceAuthority": {
      "enum": [
        "USER_EXECUTED_RUNTIME",
        "CODEX_EXECUTED_LOCAL",
        "CODEX_EXECUTED_LIVE_RUNTIME",
        "DESIGN_ONLY",
        "CONFIGURATION_ONLY",
        "MISSING"
      ]
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "capability": {
      "type": "object",
      "required": [
        "id",
        "pillar",
        "pillar_ko",
        "function",
        "function_ko",
        "capability",
        "capability_ko",
        "definition",
        "source",
        "maturity",
        "implementation_examples",
        "validation_methods",
        "evidence_types",
        "repository_status",
        "implementation_status",
        "validation_status",
        "evidence_level",
        "current_maturity",
        "assessment_confidence",
        "notes",
        "evidence_authority"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^ZT-(?:[1-6]\\.[1-9][0-9]*\\.[1-9][0-9]*|[78]\\.[1-9][0-9]*)$" },
        "pillar": { "enum": ["identity", "device-endpoint", "network", "system", "application-workload", "data", "visibility-analytics", "automation-integration"] },
        "pillar_ko": { "type": "string", "minLength": 1 },
        "function": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "function_ko": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "capability_ko": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "required": ["document", "printed_page", "table_or_figure"],
          "properties": {
            "document": { "const": "제로트러스트 가이드라인 2.0" },
            "printed_page": { "type": "string", "pattern": "^[0-9]+(?:-[0-9]+)?$" },
            "table_or_figure": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "maturity": {
          "type": "object",
          "required": ["traditional", "initial", "advanced", "optimal"],
          "properties": {
            "traditional": { "type": "string", "minLength": 1 },
            "initial": { "type": "string", "minLength": 1 },
            "advanced": { "type": "string", "minLength": 1 },
            "optimal": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "implementation_examples": { "$ref": "#/$defs/nonEmptyStringArray" },
        "validation_methods": { "$ref": "#/$defs/nonEmptyStringArray" },
        "evidence_types": { "$ref": "#/$defs/nonEmptyStringArray" },
        "repository_status": { "$ref": "#/$defs/repositoryStatus" },
        "implementation_status": { "$ref": "#/$defs/repositoryStatus" },
        "validation_status": { "$ref": "#/$defs/repositoryStatus" },
        "evidence_level": { "$ref": "#/$defs/evidenceLevel" },
        "current_maturity": { "$ref": "#/$defs/maturityValue" },
        "assessment_confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "notes": { "type": "string" },
        "evidence_authority": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceAuthority" }
        }
      },
      "additionalProperties": false
    }
  }
}
