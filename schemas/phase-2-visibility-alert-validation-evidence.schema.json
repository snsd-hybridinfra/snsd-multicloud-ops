{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P2-VIS-001 bounded alert validation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "package_id", "action_id", "validation_id", "observed_at", "environment", "evidence_authority", "authorization", "source_artifacts", "credential_reconciliation", "execution", "acceptance_cases", "cleanup", "time_integrity", "package_boundary", "decision", "explicitly_not_claimed"],
  "properties": {
    "evidence_id": {"const": "ZT-VIS-002-ALERT-VALIDATION-20260825"},
    "package_id": {"const": "ZT-VIS-002"},
    "action_id": {"const": "P2-VIS-001"},
    "validation_id": {"pattern": "^P2VISALT-[0-9]{8}T[0-9]{6}Z$"},
    "observed_at": {"format": "date-time"},
    "environment": {"const": "NON_PRODUCTION_SINGLE_NODE_OPENSTACK_LAB"},
    "evidence_authority": {"const": "CODEX_EXECUTED_LIVE_RUNTIME"},
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["alert_validation", "rule_mutation", "notification_delivery", "cleanup", "grafana_credential_reconciliation", "package_status_promotion"],
      "properties": {
        "alert_validation": {"const": true}, "rule_mutation": {"const": true},
        "notification_delivery": {"const": true}, "cleanup": {"const": true},
        "grafana_credential_reconciliation": {"const": true},
        "package_status_promotion": {"const": false}
      }
    },
    "source_artifacts": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
        "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "credential_reconciliation": {
      "type": "object", "additionalProperties": false,
      "required": ["protected_file_used", "password_stdin_only", "credential_value_logged", "authenticated_api_status", "result"],
      "properties": {
        "protected_file_used": {"const": true}, "password_stdin_only": {"const": true},
        "credential_value_logged": {"const": false}, "authenticated_api_status": {"const": 200},
        "result": {"const": "PASS"}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["grafana_version", "webhook_integration_version", "ansible_failed", "ansible_unreachable", "permanent_component_count", "permanent_receiver_added", "public_listener_added", "raw_log", "sanitized_log"],
      "properties": {
        "grafana_version": {"const": "13.1.0"}, "webhook_integration_version": {"const": "v1"},
        "ansible_failed": {"const": 0}, "ansible_unreachable": {"const": 0},
        "permanent_component_count": {"const": 5}, "permanent_receiver_added": {"const": false},
        "public_listener_added": {"const": false},
        "raw_log": {
          "type": "object", "additionalProperties": false,
          "required": ["tracked", "sha256", "size_bytes", "secret_scan", "protected_value_matches"],
          "properties": {
            "tracked": {"const": false}, "sha256": {"pattern": "^[0-9a-f]{64}$"},
            "size_bytes": {"type": "integer", "minimum": 1}, "secret_scan": {"const": "PASS"},
            "protected_value_matches": {"const": 0}
          }
        },
        "sanitized_log": {
          "type": "object", "additionalProperties": false,
          "required": ["tracked", "sha256", "verification"],
          "properties": {"tracked": {"const": false}, "sha256": {"pattern": "^[0-9a-f]{64}$"}, "verification": {"const": "PASS"}}
        }
      }
    },
    "acceptance_cases": {
      "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["case_type", "result"],
        "properties": {
          "case_type": {"enum": ["POSITIVE_RULE_LIFECYCLE", "POSITIVE_NOTIFICATION_DELIVERY", "NEGATIVE_AUTHENTICATION", "BYPASS", "PERSISTENCE_BOUNDARY", "ROLLBACK"]},
          "result": {"const": "PASS"}
        }
      }
    },
    "cleanup": {
      "type": "object", "additionalProperties": false,
      "required": ["temporary_rule_count", "temporary_folder_count", "temporary_listener_absent", "target_validator_absent", "target_recovery_key_rejected", "aio_recovery_key_rejected", "control_recovery_key_rejected", "controller_transient_keys_removed", "windows_recovery_artifacts_removed", "protected_raw_log_preserved"],
      "properties": {
        "temporary_rule_count": {"const": 0}, "temporary_folder_count": {"const": 0},
        "temporary_listener_absent": {"const": true}, "target_validator_absent": {"const": true},
        "target_recovery_key_rejected": {"const": true}, "aio_recovery_key_rejected": {"const": true},
        "control_recovery_key_rejected": {"const": true}, "controller_transient_keys_removed": {"const": true},
        "windows_recovery_artifacts_removed": {"const": true}, "protected_raw_log_preserved": {"const": true}
      }
    },
    "time_integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["control_to_host_delta_seconds_max", "target_clock_skew_seconds_observed", "target_timesync_service", "upstream_packet_count", "clock_correction_executed", "status"],
      "properties": {
        "control_to_host_delta_seconds_max": {"type": "integer", "minimum": 0, "maximum": 5},
        "target_clock_skew_seconds_observed": {"type": "integer", "minimum": 1},
        "target_timesync_service": {"const": "ACTIVE_ENABLED"}, "upstream_packet_count": {"const": 0},
        "clock_correction_executed": {"const": false}, "status": {"const": "OPEN_REVIEW_REQUIRED"}
      }
    },
    "package_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["alert_gap_closed", "package_status_promoted", "p2_vis_001_completed", "central_visibility_fully_accepted", "retention_validated", "snapshot_restore_validated", "scheduled_or_continuous_validation", "maturity_assessed", "compliance_assessed", "production_readiness_claimed"],
      "properties": {
        "alert_gap_closed": {"const": false}, "package_status_promoted": {"const": false},
        "p2_vis_001_completed": {"const": false}, "central_visibility_fully_accepted": {"const": false},
        "retention_validated": {"const": false}, "snapshot_restore_validated": {"const": false},
        "scheduled_or_continuous_validation": {"const": false}, "maturity_assessed": {"const": false},
        "compliance_assessed": {"const": false}, "production_readiness_claimed": {"const": false}
      }
    },
    "decision": {"const": "ALERT_VALIDATION_EXECUTED_STATUS_REVIEW_PENDING"},
    "explicitly_not_claimed": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
