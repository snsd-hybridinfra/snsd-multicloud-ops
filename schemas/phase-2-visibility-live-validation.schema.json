  "properties": {
    "evidence_id": {"const": "ZT-VIS-002-LIVE-VALIDATION-20260824"},
    "package_id": {"const": "ZT-VIS-002"},
    "action_id": {"const": "P2-VIS-001"},
    "observed_started_at": {"type": "string", "format": "date-time"},
    "observed_completed_at": {"type": "string", "format": "date-time"},
    "environment": {"const": "NON_PRODUCTION_SINGLE_NODE_OPENSTACK_LAB"},
    "evidence_authority": {"const": "CODEX_EXECUTED_LIVE_RUNTIME"},
    "evidence_continuity": {"const": "EC3_ONE_TIME_RUNTIME"},
