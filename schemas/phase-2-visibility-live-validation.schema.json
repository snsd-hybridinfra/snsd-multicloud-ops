    "acceptance_cases": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_type", "result"],
        "properties": {
          "case_type": {"enum": ["POSITIVE", "NEGATIVE", "BYPASS", "PERSISTENCE", "ROLLBACK", "EVIDENCE_INTEGRITY", "RECOVERY"]},
          "result": {"const": "PASS"}
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_sha256", "baseline_positive_hash_match", "persistence_hash_match", "rollback_preservation_hash_match", "recovery_hash_match", "synthetic_record_count", "forbidden_field_scan"],
      "properties": {
        "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "baseline_positive_hash_match": {"const": "PASS"},
        "persistence_hash_match": {"const": "PASS"},
        "rollback_preservation_hash_match": {"const": "PASS"},
        "recovery_hash_match": {"const": "PASS"},
        "synthetic_record_count": {"const": 1},
        "forbidden_field_scan": {"const": "PASS"}
