    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_temporary_key_removed", "target_validator_removed", "target_synthetic_input_removed", "aio_forced_proxy_removed", "aio_sudoers_rule_removed", "controller_private_keys_removed", "controller_temporary_inventory_removed", "protected_state_preserved", "protected_pki_preserved", "protected_oci_archives_preserved", "external_raw_log_preserved"],
      "properties": {
        "target_temporary_key_removed": {"const": true},
        "target_validator_removed": {"const": true},
        "target_synthetic_input_removed": {"const": true},
        "aio_forced_proxy_removed": {"const": true},
        "aio_sudoers_rule_removed": {"const": true},
        "controller_private_keys_removed": {"const": true},
        "controller_temporary_inventory_removed": {"const": true},
        "protected_state_preserved": {"const": true},
        "protected_pki_preserved": {"const": true},
        "protected_oci_archives_preserved": {"const": true},
        "external_raw_log_preserved": {"const": true}
      }
    },
    "package_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_runtime_promoted", "central_monitoring_completed", "full_cinder_snapshot_restore_executed", "scheduled_or_continuous_validation", "maturity_assessed", "compliance_assessed", "production_readiness_claimed"],
      "properties": {
        "package_runtime_promoted": {"const": false},
        "central_monitoring_completed": {"const": false},
        "full_cinder_snapshot_restore_executed": {"const": false},
        "scheduled_or_continuous_validation": {"const": false},
        "maturity_assessed": {"const": false},
        "compliance_assessed": {"const": false},
        "production_readiness_claimed": {"const": false}
      }
    },
    "decision": {"const": "LIVE_VALIDATOR_EXECUTED_STATUS_PROMOTION_PENDING"},
    "explicitly_not_claimed": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
