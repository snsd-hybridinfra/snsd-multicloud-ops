      }
    },
    "execution_attempts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempt", "accepted", "result", "findings"],
          "properties": {
            "attempt": {"const": 1},
            "accepted": {"const": false},
            "result": {"const": "FAILED_REBOOT_CONTROL_CHANNEL_REMEDIATED"},
            "findings": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempt", "accepted", "result", "remediations"],
          "properties": {
            "attempt": {"const": 2},
            "accepted": {"const": true},
            "result": {"const": "PASS"},
            "remediations": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        }
      ],
      "items": false
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "external_raw_log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracked", "sha256", "size_bytes", "secret_pattern_scan"],
      "properties": {
        "tracked": {"const": false},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"const": 30357},
        "secret_pattern_scan": {"const": "PASS"}
      }
    },
    "infrastructure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terraform_resource_count", "instance_status", "port_status", "volume_status", "floating_ip_count", "running_component_count", "fixed_image_count", "dedicated_mount", "public_endpoint_created"],
      "properties": {
        "terraform_resource_count": {"const": 4},
        "instance_status": {"const": "ACTIVE"},
        "port_status": {"const": "ACTIVE"},
        "volume_status": {"const": "IN_USE"},
        "floating_ip_count": {"const": 0},
