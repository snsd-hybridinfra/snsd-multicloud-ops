{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zero Trust scheduled validation installation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_id", "schedule_id", "evidence_type", "evidence_authority", "captured_at", "approval_reference", "platform", "definition", "principal", "runtime_controls", "schedule_fingerprint", "runtime_execution_performed", "successful_scheduled_executions", "successful_distinct_scheduled_dates", "current_continuity", "target_continuity", "result", "secret_findings", "privacy_findings", "limitations"],
  "properties": {
    "package_id": {"const": "ZT-SCH-001"},
    "schedule_id": {"const": "ZTSCH-DAILY-001"},
    "evidence_type": {"const": "SCHEDULE_CONFIGURATION"},
    "evidence_authority": {"const": "USER_APPROVED_CODEX_EXECUTION"},
    "captured_at": {"type": "string", "format": "date-time"},
    "approval_reference": {"type": "string", "pattern": "^USER_APPROVED_ZT_SCH_001_(INSTALL|UPDATE)_[A-Za-z0-9._-]+$"},
    "platform": {"const": "WINDOWS_TASK_SCHEDULER"},
    "definition": {"type": "object", "required": ["task_path", "task_name", "state", "enabled", "trigger", "interval_days", "daily_start_time_local", "time_zone", "next_run_time", "definition_status"]},
    "principal": {
      "type": "object", "required": ["logon_type", "run_level", "credential_stored", "account_value_recorded"],
      "properties": {"logon_type":{"const":"INTERACTIVE_TOKEN"},"run_level":{"const":"LIMITED"},"credential_stored":{"const":false},"account_value_recorded":{"const":false}}
    },
    "runtime_controls": {
      "type": "object", "required": ["multiple_instances", "exclusive_lock", "one_attempt_per_local_date", "execution_time_limit", "child_time_limit", "start_when_available", "catch_up", "catch_up_window", "restart_count", "automatic_retry", "automatic_remediation", "infrastructure_mutation", "repository_mutation", "history_auto_append"]
    },
    "schedule_fingerprint": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "runtime_execution_performed": {"const": false},
    "successful_scheduled_executions": {"const": 0},
    "successful_distinct_scheduled_dates": {"const": 0},
    "current_continuity": {"const": "EC4_REPEATABLE_RUNTIME"},
    "target_continuity": {"const": "EC5_SCHEDULED_RUNTIME"},
    "result": {"const": "PASS_CONFIGURATION"},
    "secret_findings": {"const": 0},
    "privacy_findings": {"const": 0},
    "limitations": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
  }
}
