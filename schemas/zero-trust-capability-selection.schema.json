{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/snsd/zero-trust-capability-selection.schema.json",
  "type": "object",
  "required": [
    "architecture_package",
    "capability_count",
    "capabilities"
  ],
  "properties": {
    "architecture_package": {
      "const": "ZT-ARC-001"
    },
    "capability_count": {
      "const": 52
    },
    "capabilities": {
      "type": "array",
      "minItems": 52,
      "maxItems": 52,
      "items": {
        "type": "object",
        "required": [
          "id",
          "canonical_name_ko",
          "selection",
          "rationale",
          "source_maturity_summary",
          "target_maturity",
          "current_maturity",
          "evidence_requirements",
          "limitation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ZT-(?:[1-6]\\.[1-9][0-9]*\\.[1-9][0-9]*|[78]\\.[1-9][0-9]*)$"
          },
          "canonical_name_ko": {
            "type": "string",
            "minLength": 1
          },
          "stable_slug": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "function": {
            "type": "string"
          },
          "source_definition": {
            "type": "string"
          },
          "source_reference": {
            "type": "object"
          },
          "source_maturity_summary": {
            "type": "object"
          },
          "selection": {
            "enum": [
              "ADVANCED_PRIMARY_TARGET",
              "ADVANCED_SUPPORTING_TARGET",
              "INITIAL_TARGET",
              "DESIGN_ONLY",
              "OPTIMAL_ROADMAP_ONLY",
              "NOT_APPLICABLE",
              "UNASSESSED"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 40
          },
          "lab_feasibility": {
            "type": "string"
          },
          "dependency_ids": {
            "type": "array"
          },
          "target_maturity": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "TRADITIONAL",
              "INITIAL",
              "ADVANCED",
              "OPTIMAL",
              "UNASSESSED",
              "NOT_APPLICABLE",
              null
            ]
          },
          "target_phase": {
            "type": "string"
          },
          "roadmap_status": {
            "type": "string"
          },
          "current_maturity": {
            "enum": [
              "TRADITIONAL",
              "INITIAL",
              "ADVANCED",
              "OPTIMAL",
              "UNASSESSED",
              "NOT_APPLICABLE"
            ]
          },
          "current_implementation_status": {
            "type": "string"
          },
          "current_validation_status": {
            "type": "string"
          },
          "current_evidence_level": {
            "type": "string"
          },
          "current_evidence_authority": {
            "type": "array"
          },
          "current_evidence": {
            "type": "array"
          },
          "evidence_requirements": {
            "type": "array",
            "minItems": 1
          },
          "limitation": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
