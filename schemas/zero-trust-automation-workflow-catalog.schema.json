{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zero Trust automation workflow catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "workflows"],
  "properties": {
    "metadata": {"type":"object","required":["environment","catalog_version","authority","default_execution_mode","limitations"]},
    "workflows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id","display_name","purpose","trigger","required_inputs","preconditions","policy_requirements","approval_level","risk_level","execution_mode","timeout_seconds","concurrency_policy","steps","success_criteria","partial_success_criteria","failure_criteria","rollback","outputs","telemetry_events","capability_mappings","implementation_status","validation_status","limitations"],
        "properties": {
          "id": {"type":"string","pattern":"^(?:ZTA-WF-[A-Z]+-[0-9]{3}|ZT-CV-WF-[0-9]{3})$"},
          "execution_mode": {"enum":["CHECK","PLAN","EXECUTE_READ_ONLY","PROPOSAL_ONLY","PROHIBITED"]},
          "timeout_seconds": {"type":"integer","minimum":1,"maximum":3600},
          "steps": {"type":"array","minItems":1,"items":{"type":"object","required":["step_id","action_id","depends_on","condition","on_success","on_warning","on_failure","evidence_required"]}}
        }
      }
    }
  }
}
