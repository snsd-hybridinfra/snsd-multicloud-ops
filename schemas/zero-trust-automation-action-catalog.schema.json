{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zero Trust automation action catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "actions"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["environment", "catalog_version", "authority", "default_policy", "limitations"]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "display_name", "purpose", "action_type", "implementation", "executable", "fixed_arguments", "allowed_parameters", "prohibited_parameters", "working_directory", "input_schema", "output_schema", "risk_level", "approval_level", "timeout_seconds", "retry_policy", "idempotent", "concurrency_policy", "rollback_type", "rollback_action", "evidence_required", "telemetry_events", "capability_mappings", "implementation_status", "validation_status", "limitations"],
        "properties": {
          "id": {"type": "string", "pattern": "^ZTA-ACT-[A-Z]+-[0-9]{3}$"},
          "action_type": {"enum": ["LOCAL_VALIDATION", "REMOTE_READ_ONLY_VALIDATION", "EVIDENCE_COLLECTION", "EVIDENCE_SANITIZATION", "SCHEMA_VALIDATION", "CORRELATION", "REPORT_GENERATION", "STATUS_PROPOSAL", "NOTIFICATION_PROPOSAL", "INCIDENT_HANDOFF", "CONFIGURATION_PROPOSAL", "PROHIBITED_REFERENCE"]},
          "executable": {"type": "boolean"},
          "fixed_arguments": {"type": "array"},
          "allowed_parameters": {"type": "array"},
          "prohibited_parameters": {"type": "array", "items": {"type": "string"}},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 1200},
          "retry_policy": {"enum": ["NONE", "FIXED_COUNT_READ_ONLY"]},
          "risk_level": {"enum": ["R0_READ_ONLY", "R1_LOCAL_ARTIFACT_WRITE", "R2_REPOSITORY_STATUS_PROPOSAL", "R3_REMOTE_READ_ONLY", "R4_LOW_RISK_CONFIGURATION", "R5_SERVICE_AFFECTING", "R6_NETWORK_AFFECTING", "R7_ACCESS_AFFECTING", "R8_DESTRUCTIVE"]},
          "approval_level": {"enum": ["APPROVAL_NONE", "APPROVAL_POLICY", "APPROVAL_OPERATOR", "APPROVAL_SECURITY_REVIEW", "APPROVAL_CHANGE_CONTROL", "APPROVAL_EXPLICIT_USER", "APPROVAL_PROHIBITED"]}
        }
      }
    }
  }
}
