{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/snsd/zero-trust-role-policy-matrix.schema.json",
  "type": "object",
  "required": ["schema_version", "package_id", "policy_version", "default_policy", "actions", "roles"],
  "properties": {
    "schema_version": {"$ref": "zero-trust-identity-common.schema.json#/$defs/schemaVersion"},
    "package_id": {"$ref": "zero-trust-identity-common.schema.json#/$defs/packageId"},
    "policy_version": {"$ref": "zero-trust-identity-common.schema.json#/$defs/policyVersion"},
    "default_policy": {"const": "DENY_BY_DEFAULT_FOR_UNREGISTERED_IDENTITY"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "classification", "runtime_access", "secret_access"],
        "properties": {
          "action": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "classification": {"enum": ["READ_ONLY", "VALIDATION", "EVIDENCE_READ", "EVIDENCE_REVIEW", "APPROVAL", "MUTATING", "EMERGENCY", "PHASE_2_RUNTIME"]},
          "runtime_access": {"type": "boolean"},
          "secret_access": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "roles": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["role_name", "allowed_actions", "prohibited_actions", "approval_requirements", "interactive_access_boundary", "mutating_access_boundary", "evidence_access_boundary", "runtime_access_boundary", "secret_access_boundary", "separation_of_duties_conflicts"],
        "properties": {
          "role_name": {"$ref": "zero-trust-identity-common.schema.json#/$defs/roleName"},
          "allowed_actions": {"type": "array", "items": {"type": "string"}},
          "prohibited_actions": {"type": "array", "items": {"type": "string"}},
          "approval_requirements": {"type": "array", "items": {"type": "string"}},
          "interactive_access_boundary": {"type": "string", "minLength": 1},
          "mutating_access_boundary": {"type": "string", "minLength": 1},
          "evidence_access_boundary": {"type": "string", "minLength": 1},
          "runtime_access_boundary": {"type": "string", "minLength": 1},
          "secret_access_boundary": {"type": "string", "minLength": 1},
          "separation_of_duties_conflicts": {"type": "array", "items": {"$ref": "zero-trust-identity-common.schema.json#/$defs/roleName"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
