{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snsd.example/schemas/zero-trust-device-inventory.schema.json",
  "title": "Bounded Zero Trust Device Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "assets"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "package_id": {"const": "ZT-DEV-001"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id", "asset_type", "environment", "owner_role",
          "management_state", "privileged", "compliance_profile",
          "assessment_requirement", "collection_method", "source_authority",
          "data_minimization", "limitations"
        ],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^ZTD-ASSET-[A-Z0-9-]+$"},
          "asset_type": {"enum": ["OPENSTACK_HOST", "EVE_HOST", "LINUX_WORKLOAD", "MONITORING_VM", "NETWORK_DEVICE", "WINDOWS_OPERATOR"]},
          "environment": {"enum": ["NON_PRODUCTION_LAB", "OPERATOR_CONTROL_PLANE"]},
          "owner_role": {"type": "string", "minLength": 1},
          "management_state": {"enum": ["MANAGED", "PARTIALLY_MANAGED", "DECLARED_ONLY", "OUT_OF_SCOPE"]},
          "privileged": {"type": "boolean"},
          "compliance_profile": {"type": "string", "pattern": "^ZTD-PROFILE-[A-Z0-9-]+$"},
          "assessment_requirement": {"enum": ["MANDATORY_LIVE", "BOUNDED_VALIDATOR_ONLY", "INVENTORY_ONLY", "EXCLUDED"]},
          "collection_method": {"type": "string", "minLength": 1},
          "source_authority": {"enum": ["CODEX_EXECUTED_LIVE_RUNTIME", "EXISTING_RESTRICTED_VALIDATOR", "DECLARED_CONFIGURATION", "EXCLUDED_PHYSICAL_BOUNDARY"]},
          "data_minimization": {"type": "string", "minLength": 1},
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
