{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/snsd/zero-trust-identity-evidence.schema.json",
  "$defs": {
    "localEvidence": {
      "type": "object",
      "required": ["package_id", "capability_ids", "execution_authority", "execution_mode", "validator", "validator_version", "policy_version", "fixture_set", "timestamp", "target", "result", "pass_count", "warn_count", "fail_count", "positive_cases", "negative_cases", "runtime_executed", "live_identity_changed", "secret_findings", "privacy_findings", "limitations", "status"],
      "properties": {
        "package_id": {"$ref": "zero-trust-identity-common.schema.json#/$defs/packageId"},
        "capability_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "zero-trust-identity-common.schema.json#/$defs/capabilityId"}},
        "execution_authority": {"const": "CODEX_EXECUTED_LOCAL"},
        "execution_mode": {"const": "SYNTHETIC_FIXTURE_VALIDATION"},
        "validator": {"const": "tools/validate_zt_id_001.py"},
        "validator_version": {"const": "1.0.0"},
        "policy_version": {"const": "1.0.0"},
        "fixture_set": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "target": {"const": "LOCAL_REPOSITORY_FIXTURES"},
        "result": {"const": "PASS"},
        "pass_count": {"type": "integer", "minimum": 1},
        "warn_count": {"const": 0},
        "fail_count": {"const": 0},
        "positive_cases": {"type": "array", "minItems": 8, "items": {"type": "object"}},
        "negative_cases": {"type": "array", "minItems": 30, "items": {"type": "object"}},
        "runtime_executed": {"const": false},
        "live_identity_changed": {"const": false},
        "secret_findings": {"const": 0},
        "privacy_findings": {"const": 0},
        "limitations": {"$ref": "zero-trust-identity-common.schema.json#/$defs/limitations"},
        "status": {"const": "LOCAL_VALIDATION_ONLY"}
      },
      "additionalProperties": false
    },
    "runtimeEvidence": {
      "type": "object",
      "required": ["action_id", "parent_action_id", "package_id", "capability_ids", "execution_authority", "execution_mode", "target_alias", "target_environment", "target_class", "recovery_path", "operator_access", "validator_identity", "account_created_or_reused", "group_created_or_reused", "forced_command", "ssh_enforcement", "sudoers_enforcement", "third_party_sudoers_unchanged", "backup_created", "rollback_armed", "rollback_cancelled", "residual_jobs", "positive_test_count", "positive_pass_count", "negative_test_count", "negative_denied_count", "unexpected_allowances", "protected_state_mutations", "sshd_validation", "sudoers_package_validation", "sudoers_global_validation", "ssh_reload", "service_health", "runtime_executed", "live_identity_changed", "identity_provider_deployed", "mfa_enforced", "oidc_deployed", "rbac_runtime_enforced", "secret_findings", "privacy_findings", "limitations", "evidence_freshness", "implementation_status", "validation_status", "runtime_validation_status", "runtime_acceptance_status", "maturity_status", "validator", "validator_version", "policy_version", "result", "timestamp"],
      "properties": {
        "action_id": {"const": "P1-ID-ENF-001-RETRY"},
        "parent_action_id": {"const": "P1-ID-ENF-001"},
        "package_id": {"const": "ZT-ID-001"},
        "capability_ids": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"$ref": "zero-trust-identity-common.schema.json#/$defs/capabilityId"}},
        "execution_authority": {"const": "USER_APPROVED_CODEX_EXECUTION"},
        "execution_mode": {"const": "BOUNDED_NON_PRODUCTION_ENFORCEMENT"},
        "target_alias": {"const": "NONPROD_VALIDATOR_TARGET_01"},
        "target_environment": {"const": "NON_PRODUCTION"},
        "target_class": {"const": "EVE_NG_RESTRICTED_VALIDATOR_ENDPOINT"},
        "recovery_path": {"const": "INDEPENDENT_VMWARE_CONSOLE_AND_TARGET_LOCAL_ROLLBACK"},
        "operator_access": {"const": "PASS"},
        "validator_identity": {"const": "DEDICATED_PACKAGE_OWNED_VALIDATOR"},
        "account_created_or_reused": {"enum": ["CREATED", "REUSED"]},
        "group_created_or_reused": {"enum": ["CREATED", "REUSED"]},
        "forced_command": {"const": "ENFORCED"},
        "ssh_enforcement": {"const": "ENFORCED"},
        "sudoers_enforcement": {"const": "ENFORCED"},
        "third_party_sudoers_unchanged": {"const": true},
        "backup_created": {"const": true},
        "rollback_armed": {"const": true},
        "rollback_cancelled": {"const": true},
        "residual_jobs": {"const": 0},
        "positive_test_count": {"type": "integer", "minimum": 20},
        "positive_pass_count": {"type": "integer", "minimum": 20},
        "negative_test_count": {"type": "integer", "minimum": 42},
        "negative_denied_count": {"type": "integer", "minimum": 42},
        "unexpected_allowances": {"const": 0},
        "protected_state_mutations": {"const": "PACKAGE_OWNED_CONFIGURATION_ONLY"},
        "sshd_validation": {"const": "PASS"},
        "sudoers_package_validation": {"const": "PASS"},
        "sudoers_global_validation": {"const": "PASS"},
        "ssh_reload": {"const": "PASS"},
        "service_health": {"const": "PASS"},
        "runtime_executed": {"const": true},
        "live_identity_changed": {"const": true},
        "identity_provider_deployed": {"const": false},
        "mfa_enforced": {"const": false},
        "oidc_deployed": {"const": false},
        "rbac_runtime_enforced": {"const": false},
        "secret_findings": {"const": 0},
        "privacy_findings": {"const": 0},
        "limitations": {"$ref": "zero-trust-identity-common.schema.json#/$defs/limitations"},
        "evidence_freshness": {"const": "CURRENT_ACTION"},
        "implementation_status": {"const": "IMPLEMENTED"},
        "validation_status": {"const": "RUNTIME_VALIDATED"},
        "runtime_validation_status": {"const": "VALIDATED"},
        "runtime_acceptance_status": {"const": "ACCEPTED"},
        "maturity_status": {"const": "UNASSESSED"},
        "validator": {"const": "tools/validate_zt_id_001.py"},
        "validator_version": {"const": "1.1.0"},
        "policy_version": {"const": "1.1.0"},
        "result": {"const": "PASS"},
        "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/localEvidence"},
    {"$ref": "#/$defs/runtimeEvidence"}
  ]
}
