{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snsd.local/schemas/idp-runner-bundle-manifest.schema.json",
  "title": "IDP supply-chain runner bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "os", "architecture", "bundle", "tools"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "os": {"const": "ubuntu-24.04"},
    "architecture": {"const": "x86_64"},
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "url", "approved_host", "sha256"],
      "properties": {
        "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "url": {"type": "string", "pattern": "^https://[^/]+/.+$"},
        "approved_host": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,251}[a-z0-9]$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions-runner", "cosign", "docker", "docker-buildx", "gh", "git", "syft", "trivy"],
      "properties": {
        "actions-runner": {"$ref": "#/$defs/actionsRunner"},
        "cosign": {"$ref": "#/$defs/cosign"},
        "docker": {"$ref": "#/$defs/docker"},
        "docker-buildx": {"$ref": "#/$defs/dockerBuildx"},
        "gh": {"$ref": "#/$defs/gh"},
        "git": {"$ref": "#/$defs/git"},
        "syft": {"$ref": "#/$defs/syft"},
        "trivy": {"$ref": "#/$defs/trivy"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "toolBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "path", "sha256"],
      "properties": {
        "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$"},
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "actionsRunner": {"allOf": [{"$ref": "#/$defs/toolBase"}, {"properties": {"path": {"const": "/opt/actions-runner/bin/Runner.Listener"}}}]},
    "cosign": {"allOf": [{"$ref": "#/$defs/toolBase"}, {"properties": {"path": {"const": "/usr/local/bin/cosign"}}}]},
    "docker": {"allOf": [{"$ref": "#/$defs/toolBase"}, {"properties": {"path": {"const": "/usr/local/bin/docker"}}}]},
    "dockerBuildx": {"allOf": [{"$ref": "#/$defs/toolBase"}, {"properties": {"path": {"const": "/usr/local/lib/docker/cli-plugins/docker-buildx"}}}]},
    "gh": {"allOf": [{"$ref": "#/$defs/toolBase"}, {"properties": {"path": {"const": "/usr/local/bin/gh"}}}]},
    "git": {"allOf": [{"$ref": "#/$defs/toolBase"}, {"properties": {"path": {"const": "/usr/local/bin/git"}}}]},
    "syft": {"allOf": [{"$ref": "#/$defs/toolBase"}, {"properties": {"path": {"const": "/usr/local/bin/syft"}}}]},
    "trivy": {"allOf": [{"$ref": "#/$defs/toolBase"}, {"properties": {"path": {"const": "/usr/local/bin/trivy"}}}]}
  }
}
