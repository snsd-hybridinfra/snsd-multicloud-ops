{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/zt-kisa-technical-control-mapping.schema.json",
  "title": "Integrated Zero Trust and KISA technical-control mapping framework",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "framework_layers", "package_flow", "exception_policy", "package_summaries", "target_classes", "mappings"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "authority", "action_id", "project_title_ko", "project_title_en", "portfolio_title", "guide_reference_id", "guide_sha256", "mapping_count", "exact_item_mapping_count", "governance_mapping_count", "package_summary_count", "target_class_count", "mapping_status", "accepted_at", "implementation_promoted", "runtime_status_promoted", "maturity_assessed", "compliance_assessed", "limitations"],
      "properties": {
        "schema_version": {"const": "2.0.0"},
        "authority": {"const": "ZT_KISA_TECHNICAL_CONTROL_MAPPING_FRAMEWORK"},
        "action_id": {"const": "ZT-GOV-MAP-001"},
        "project_title_ko": {"type": "string", "minLength": 1},
        "project_title_en": {"type": "string", "minLength": 1},
        "portfolio_title": {"type": "string", "minLength": 1},
        "guide_reference_id": {"const": "KISA-CRITICAL-INFRASTRUCTURE-2026"},
        "guide_sha256": {"pattern": "^[a-f0-9]{64}$"},
        "mapping_count": {"type": "integer", "minimum": 1},
        "exact_item_mapping_count": {"type": "integer", "minimum": 1},
        "governance_mapping_count": {"type": "integer", "minimum": 1},
        "package_summary_count": {"const": 12},
        "target_class_count": {"const": 16},
        "mapping_status": {"const": "SOURCE_VERIFIED_FRAMEWORK_ACCEPTED"},
        "accepted_at": {"type": "string", "format": "date"},
        "implementation_promoted": {"const": false},
        "runtime_status_promoted": {"const": false},
        "maturity_assessed": {"const": false},
        "compliance_assessed": {"const": false},
        "limitations": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "framework_layers": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["layer_id", "name", "authority", "authority_rule"],
        "properties": {
          "layer_id": {"enum": ["LAYER_1_ZERO_TRUST", "LAYER_2_KISA_REFERENCE", "LAYER_3_IMPLEMENTATION_PACKAGE", "LAYER_4_AUTOMATED_VALIDATION"]},
          "name": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1},
          "authority_rule": {"type": "string", "minLength": 1}
        }
      }
    },
    "package_flow": {
      "type": "object", "additionalProperties": false,
      "required": ["architecture_authority", "sequence", "terminal", "status_authority"],
      "properties": {
        "architecture_authority": {"const": "ZT-ARC-001"},
        "sequence": {"const": ["ZT-FND-001", "ZT-NET-001", "ZT-VIS-001", "ZT-ID-001", "ZT-CV-001", "ZT-RV-001", "ZT-SCH-001"]},
        "terminal": {"const": "P1-ACC-001"},
        "status_authority": {"const": "docs/zero-trust/package-status.yaml"}
      }
    },
    "exception_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["exception_status", "exception_owner_role", "exception_reason", "compensating_controls", "evidence_requirements", "residual_risk", "review_due_rule", "approval_evidence", "equivalent_configuration_rule"],
      "properties": {
        "exception_status": {"enum": ["NOT_REQUESTED", "PROPOSED", "APPROVED", "REJECTED", "EXPIRED"]},
        "exception_owner_role": {"type": "string", "minLength": 1},
        "exception_reason": {"type": "string", "minLength": 1},
        "compensating_controls": {"$ref": "#/$defs/nonEmptyStrings"},
        "evidence_requirements": {"$ref": "#/$defs/nonEmptyStrings"},
        "residual_risk": {"type": "string", "minLength": 1},
        "review_due_rule": {"type": "string", "minLength": 1},
        "approval_evidence": {"type": "string", "minLength": 1},
        "equivalent_configuration_rule": {"type": "string", "minLength": 1}
      }
    },
    "package_summaries": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/packageSummary"}},
    "target_classes": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/targetClass"}},
    "mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mappingRecord"}}
  },
  "$defs": {
    "nonEmptyStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "packageId": {"enum": ["ZT-FND-001", "ZT-NET-001", "ZT-VIS-001", "ZT-ID-001", "ZT-CV-001", "ZT-RV-001", "ZT-SCH-001", "ZT-DEV-001", "ZT-APP-001", "ZT-DATA-001", "ZT-SYS-001", "ZT-AUTO-001"]},
    "assetDomain": {"enum": ["UNIX_SERVER", "WINDOWS_SERVER", "WEB_SERVICE", "SECURITY_DEVICE", "NETWORK_DEVICE", "CONTROL_SYSTEM", "PC_ENDPOINT", "DBMS", "MOBILE_TELECOMMUNICATION", "WEB_APPLICATION", "VIRTUALIZATION_PLATFORM", "CLOUD"]},
    "mappingStatus": {"enum": ["MAPPED", "PARTIALLY_MAPPED", "UNMAPPED", "NOT_APPLICABLE"]},
    "implementationStatus": {"enum": ["NOT_IMPLEMENTED", "REFERENCED_ONLY", "DESIGN_ONLY", "PARTIALLY_IMPLEMENTED", "IMPLEMENTED", "IMPLEMENTED_AS_RECORDED"]},
    "itemCode": {"type": "string", "pattern": "^[A-Z]{1,3}(?:-[0-9]{2})?$"},
    "packageSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["package_id", "mapping_status", "mapping_role", "exact_item_codes", "governance_mapping_ids", "unresolved_scope"],
      "properties": {
        "package_id": {"$ref": "#/$defs/packageId"},
        "mapping_status": {"$ref": "#/$defs/mappingStatus"},
        "mapping_role": {"enum": ["TECHNICAL_CONTROL", "VALIDATION_ORCHESTRATION", "TECHNICAL_AND_GOVERNANCE"]},
        "exact_item_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/itemCode"}},
        "governance_mapping_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^MAP-ZT-[A-Z]+-[0-9]{3}-[A-Z0-9-]+$"}},
        "unresolved_scope": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "targetClass": {
      "type": "object", "additionalProperties": false,
      "required": ["target_class", "kisa_asset_domains", "package_owners", "current_implementation_status", "future_phase", "evidence_method", "protected_scope", "exclusions"],
      "properties": {
        "target_class": {"enum": ["EVE_NG", "OPENSTACK_AIO", "OPENSTACK_VM", "LINUX_HOST", "WINDOWS_HOST", "NETWORK_SECURITY_APPLIANCE", "KUBERNETES_NODE", "KUBERNETES_WORKLOAD", "DATABASE", "WEB_SERVICE", "MONITORING_PLATFORM", "IDENTITY_PLATFORM", "VIRTUALIZATION_PLATFORM", "PUBLIC_CLOUD_ACCOUNT", "PUBLIC_CLOUD_NETWORK", "PUBLIC_CLOUD_COMPUTE"]},
        "kisa_asset_domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/assetDomain"}},
        "package_owners": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/packageId"}},
        "current_implementation_status": {"$ref": "#/$defs/implementationStatus"},
        "future_phase": {"type": "string", "minLength": 1},
        "evidence_method": {"type": "string", "minLength": 1},
        "protected_scope": {"$ref": "#/$defs/nonEmptyStrings"},
        "exclusions": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "mappingRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["mapping_id", "zt_package_id", "zt_capability_ids", "zt_control_purpose", "zt_pillar", "kisa_guide_edition", "kisa_asset_domain", "kisa_item_code", "kisa_item_name", "kisa_severity", "source_page", "mapping_type", "technical_target", "applicability", "mapping_status", "implementation_status", "local_validation_status", "runtime_validation_status", "evidence_status", "maturity_status", "compliance_status", "check_mode", "remediation_mode", "positive_test_required", "negative_test_required", "persistence_test_required", "rollback_required", "evidence_requirements", "operational_impact", "version_constraints", "exception_policy", "compensating_control_policy", "limitations", "source_reference", "duplicate_mapping_rationale"],
      "properties": {
        "mapping_id": {"type": "string", "pattern": "^MAP-ZT-[A-Z]+-[0-9]{3}-[A-Z0-9-]+$"},
        "zt_package_id": {"$ref": "#/$defs/packageId"},
        "zt_capability_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ZT-(?:[1-6]\\.[0-9]+\\.[0-9]+|[78]\\.[0-9]+)$"}},
        "zt_control_purpose": {"type": "string", "minLength": 1},
        "zt_pillar": {"enum": ["identity", "device-endpoint", "network", "system", "application-workload", "data", "visibility-analytics", "automation-integration"]},
        "kisa_guide_edition": {"const": "2026"},
        "kisa_asset_domain": {"anyOf": [{"$ref": "#/$defs/assetDomain"}, {"type": "null"}]},
        "kisa_item_code": {"anyOf": [{"$ref": "#/$defs/itemCode"}, {"type": "null"}]},
        "kisa_item_name": {"type": ["string", "null"]},
        "kisa_severity": {"enum": ["HIGH", "MEDIUM", "LOW", "NOT_APPLICABLE"]},
        "source_page": {"type": ["integer", "null"], "minimum": 1, "maximum": 873},
        "mapping_type": {"enum": ["DIRECT", "SUPPORTING", "PARTIAL", "GOVERNANCE_ONLY", "FUTURE_SCOPE", "NOT_APPLICABLE"]},
        "technical_target": {"type": "string", "minLength": 1},
        "applicability": {"enum": ["APPLICABLE", "CONDITIONALLY_APPLICABLE", "NOT_APPLICABLE", "NOT_YET_ASSESSED"]},
        "mapping_status": {"$ref": "#/$defs/mappingStatus"},
        "implementation_status": {"const": "REFERENCED_ONLY"},
        "local_validation_status": {"const": "NOT_VALIDATED"},
        "runtime_validation_status": {"const": "NOT_VALIDATED"},
        "evidence_status": {"const": "SOURCE_METADATA_ONLY"},
        "maturity_status": {"const": "UNASSESSED"},
        "compliance_status": {"const": "NOT_ASSESSED"},
        "check_mode": {"enum": ["READ_ONLY", "DESIGN_REVIEW", "FUTURE_TARGET_REVIEW"]},
        "remediation_mode": {"const": "APPROVAL_GATED_MINIMUM_CHANGE"},
        "positive_test_required": {"type": "boolean"},
        "negative_test_required": {"type": "boolean"},
        "persistence_test_required": {"type": "boolean"},
        "rollback_required": {"type": "boolean"},
        "evidence_requirements": {"$ref": "#/$defs/nonEmptyStrings"},
        "operational_impact": {"type": "string", "minLength": 1},
        "version_constraints": {"type": "string", "minLength": 1},
        "exception_policy": {"type": "string", "minLength": 1},
        "compensating_control_policy": {"type": "string", "minLength": 1},
        "limitations": {"type": "string", "minLength": 1},
        "source_reference": {"type": "string", "minLength": 1},
        "duplicate_mapping_rationale": {"type": ["string", "null"]}
      },
      "allOf": [{
        "if": {"properties": {"mapping_type": {"const": "GOVERNANCE_ONLY"}}, "required": ["mapping_type"]},
        "then": {"properties": {"kisa_asset_domain": {"type": "null"}, "kisa_item_code": {"type": "null"}, "kisa_item_name": {"type": "null"}, "kisa_severity": {"const": "NOT_APPLICABLE"}, "source_page": {"type": "null"}, "check_mode": {"const": "DESIGN_REVIEW"}}},
        "else": {"properties": {"kisa_asset_domain": {"$ref": "#/$defs/assetDomain"}, "kisa_item_code": {"$ref": "#/$defs/itemCode"}, "kisa_item_name": {"type": "string", "minLength": 1}, "kisa_severity": {"enum": ["HIGH", "MEDIUM", "LOW"]}, "source_page": {"type": "integer", "minimum": 1, "maximum": 873}}}
      }]
    }
  }
}
