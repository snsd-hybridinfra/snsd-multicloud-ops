{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Zero Trust automation execution record","type":"object","additionalProperties":false,"required":["execution_id","workflow_id","execution_mode","plan_hash","execution_authority","start_time","end_time","duration_seconds","result","steps","sanitization","telemetry_events"],"properties":{"execution_id":{"type":"string"},"workflow_id":{"type":"string","pattern":"^ZTA-WF-"},"execution_mode":{"enum":["CHECK","PLAN","EXECUTE_READ_ONLY","PROPOSAL_ONLY"]},"plan_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"execution_authority":{"enum":["CODEX_EXECUTED_LOCAL","CODEX_EXECUTED_LIVE_RUNTIME","CHECK_ONLY","PLAN_ONLY"]},"result":{"enum":["COMPLETE","PARTIAL","FAILED","BLOCKED","CONFIGURATION_ERROR"]},"steps":{"type":"array"},"sanitization":{"type":"object"},"telemetry_events":{"type":"array"}}}
